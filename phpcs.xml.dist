<?xml version="1.0"?>
<ruleset name="OpenQR WordPress">
	<description>Coding standard for the OpenQR WordPress plugin (WordPress-Extra + Docs, PHP 7.4-8.5).</description>

	<file>includes</file>
	<file>openqr.php</file>
	<file>uninstall.php</file>
	<!-- tests are scanned by phpcs.tests.xml.dist, run by `composer lint` right after this
	     ruleset: same functional sniffs, minus the docblock and file-naming rules that only
	     make sense on production classes. -->

	<exclude-pattern>/vendor/</exclude-pattern>
	<exclude-pattern>/node_modules/</exclude-pattern>
	<exclude-pattern>/build/</exclude-pattern>
	<exclude-pattern>/.wordpress-org/</exclude-pattern>
	<exclude-pattern>/src/</exclude-pattern>

	<rule ref="WordPress">
		<!-- The plugin prefixes all options with openqr_ and all functions/classes with
		     OpenQR_ / openqr_; the sniffer's dynamic list is advisory here. -->
		<exclude name="WordPress.WP.DeprecatedFunctions" />
		<!-- Lowercase "wordpress" is a legitimate UTM VALUE in marketing links; the sniffer's
		     auto-fix rewrote it and corrupted the parameter. JS is linted by wp-scripts. -->
		<exclude name="WordPress.WP.CapitalPDangit" />
		<!-- The plugin's two capabilities (openqr_manage_connection, openqr_manage_codes) are
		     plugin-defined and registered at runtime via add_cap(). The sniff's
		     custom_capabilities ruleset property does not apply in WPCS 3.1 (verified), so the
		     "unknown capability" warning is silenced; deprecated-cap and role-as-cap checks
		     stay active. -->
		<exclude name="WordPress.WP.Capabilities.Unknown" />
	</rule>

	<config name="text_domain" value="openqr" />
	<config name="testVersion" value="7.4-8.5" />
	<rule ref="PHPCompatibilityWP" />
</ruleset>
